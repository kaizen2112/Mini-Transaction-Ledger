# Browser-side base URL for the API. Anything prefixed NEXT_PUBLIC_ is inlined
# into the client bundle at build time and is therefore public — no secret ever
# gets that prefix (docs/08-docker.md §2).
#
# Inside Docker Compose this stays http://localhost:8080: the code that uses it
# runs in the reviewer's browser, where `api` is not a resolvable hostname.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
